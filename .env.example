# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every key listed here must also be present in
# `.env` (dotenv-safe enforces that), so add new keys to BOTH files.
# ---------------------------------------------------------------------------

# Port the HTTP server binds to. Defaults to 3000 when unset.
PORT=3000

# development | production | test
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API.
# Ignored while NODE_ENV=development (all origins are allowed there).
CORS_ALLOWED_ORIGINS=

PORT=3000
NODE_ENV=development          # development | production
LOG_LEVEL=info                # debug | info | warn | error
CORS_ALLOWED_ORIGINS=         # Comma-separated list of allowed origins in production
HUBSPOT_ACCESS_TOKEN=         # Private App access token from HubSpot
HUBSPOT_API_BASE_URL=         # https://api.hubapi.com
HUBSPOT_MARKETING_EVENT_EXTERNAL_ACCOUNT_ID=   # Arbitrary constant identifying this integration as the "account" that owns externalEventId-based Marketing Events (e.g. your Teachable school subdomain). Pick one value and never change it once live.
HUBSPOT_MARKETING_EVENT_ORGANIZER=Teachable  # eventOrganizer value used when this integration creates/owns a Marketing Event
TEACHABLE_WEBHOOK_PATH_SECRET=  # Long random secret (32+ chars) embedded in the webhook URL path. Teachable does not sign its webhooks, so this is the only inbound authentication mechanism. Generate with: openssl rand -hex 32
COURSE_MAPPING_FILE_PATH=      # Optional. Defaults to <repo root>/course-mapping.json
MAX_PROCESSING_ATTEMPTS=5      # Max claim/retry attempts per enrollment before a failure is marked permanent
STALE_PROCESSING_TIMEOUT_MS=300000  # How long an enrollment may sit claimed as PROCESSING (e.g. after a crash/hang) before it is eligible for reclaim
TEACHABLE_API_KEY=    
TEACHABLE_API_BASE_URL="https://developers.teachable.com/v1"
MARKETING_EVENT_EXTERNAL_ID_PREFIX=
ASSOCIATION_TYPE_ID_SOURCE_COMPANY_DIRECTOR=203
ASSOCIATION_TYPE_ID_SOURCE_COMPANY_SHAREHOLDER_OVER_25=227
ASSOCIATION_TYPE_ID_SOURCE_COMPANY_SHAREHOLDER_UNDER_25=235
ASSOCIATION_TYPE_ID_SOURCE_SECURITY_OWNER=34
ASSOCIATION_TYPE_ID_SOURCE_TRUST_BENEFICIARY=253
ASSOCIATION_TYPE_ID_SOURCE_TRUST_APPOINTOR=281
ASSOCIATION_TYPE_ID_SOURCE_TRUST_UNITHOLDER=269

